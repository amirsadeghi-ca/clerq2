DATABASE_URL=postgresql+psycopg://interpret:interpret@postgres:5432/interpret
REDIS_URL=redis://redis:6379/0
STORAGE_PATH=/app/data/storage
SECRET_KEY=change-me-in-production
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=google/gemini-2.0-flash-exp

# Auth (JWT)
# JWT_SECRET=                    # optional; falls back to SECRET_KEY
# ACCESS_TOKEN_MINUTES=30
# REFRESH_TOKEN_DAYS=30

# Invite flow
APP_BASE_URL=http://localhost
# INVITE_EXPIRY_DAYS=7

# Email delivery (Resend)
# Without RESEND_API_KEY the mailer logs to stdout instead of sending.
# INVITE_FROM_ADDRESS must be on a Resend-verified domain in your account.
RESEND_API_KEY=
INVITE_FROM_ADDRESS=noreply@email.genitechs.ca
INVITE_FROM_NAME=Interpret

# Inbound mail (Resend Inbound → POST /api/mail/resend-inbound)
# MAIL_INBOUND_DOMAIN: the domain that receives policy-N@…/workflow-N@… mail.
#   Must be a Resend domain with the "Receiving" toggle ON + its MX record added.
# RESEND_INBOUND_WEBHOOK_SECRET: the Svix signing secret ("whsec_…") shown when
#   you create the email.received webhook in Resend. Blank = signature check
#   skipped (DEV ONLY — never leave blank in production).
MAIL_INBOUND_DOMAIN=email.genitechs.ca
RESEND_INBOUND_WEBHOOK_SECRET=
MAIL_MAX_ATTACHMENT_BYTES=26214400

# For local dev outside Docker (run api/ directly):
# DATABASE_URL=postgresql+psycopg://interpret:interpret@localhost:5432/interpret
# REDIS_URL=redis://localhost:6379/0
# STORAGE_PATH=./data/storage
